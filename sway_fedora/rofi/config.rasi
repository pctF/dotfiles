/**
 * Rofi theme — Nord, matched to waybar/nwg-panel palette.
 * Rofi version: 2.0.0
 **/

* {
    bg0:      #2E3440E6; /* nord0, mostly opaque */
    bg1:      #3B4252F0; /* nord1 */
    bg2:      #434C5EFF; /* nord2 */
    fg:       #ECEFF4FF; /* nord6 */
    fg-dim:   #D8DEE988; /* nord4, dim */
    accent:   #88C0D0FF; /* nord8 sky */
    accent2:  #A3BE8CFF; /* nord14 green — secondary accent */
    urgent:   #BF616AFF; /* nord11 red */

    background:     @bg0;
    background-alt: @bg2;
    foreground:     @fg;
    selected:       @accent;
    active:         @accent2;
}

/*****----- Configuration -----*****/
configuration {
    modi:                       "combi,geval:/home/ivan/projects/personal/dotfiles/sway_fedora/rofi/scripts/groovy-eval.sh,sysmenu:/home/ivan/projects/personal/dotfiles/sway_fedora/rofi/scripts/system-menu.sh";
    combi-modi:                 "drun";
    combi-display-format:       "{text}";
    show-icons:                 true;
    icon-theme:                  "Papirus-Dark";
    display-combi:              "  Apps";
    display-geval:              "  Groovy";
    display-sysmenu:            "  System";
    drun-display-format:        "{name}";
    font:                       "DejaVu Sans Mono 12, Symbols Nerd Font 12";
}

/*****----- Main Window -----*****/
window {
    transparency:                "real";
    location:                    center;
    anchor:                      center;
    fullscreen:                  false;
    width:                       860px;
    x-offset:                    0px;
    y-offset:                    -40px;
    enabled:                     true;
    margin:                      0px;
    padding:                     0px;
    border:                      1px solid;
    border-radius:               18px;
    border-color:                #4C566A99;
    background-color:            @bg1;
    cursor:                      "default";
}

/*****----- Main Box -----*****/
mainbox {
    enabled:                     true;
    spacing:                     16px;
    margin:                      0px;
    padding:                     22px;
    border:                      0px solid;
    border-radius:               0px;
    background-color:            transparent;
    children:                    [ "inputbar", "message", "listview", "mode-switcher" ];
}

/*****----- Inputbar -----*****/
inputbar {
    enabled:                     true;
    spacing:                     10px;
    margin:                      0px;
    padding:                     13px 18px;
    border:                      0px solid;
    border-radius:               12px;
    background-color:            @bg2;
    text-color:                  @foreground;
    children:                    [ "prompt", "entry" ];
}

prompt {
    enabled:                     true;
    background-color:            transparent;
    text-color:                  @accent;
}
textbox-prompt-colon {
    enabled:                     true;
    expand:                      false;
    str:                         "  ";
    background-color:            transparent;
    text-color:                  inherit;
}
entry {
    enabled:                     true;
    background-color:            transparent;
    text-color:                  inherit;
    cursor:                      text;
    placeholder:                 "Type to search...";
    placeholder-color:           @fg-dim;
}

message {
    enabled:                     true;
    margin:                      0px;
    padding:                     0px 4px;
    border:                      0px solid;
    background-color:            transparent;
}

/*****----- Listview -----*****/
listview {
    enabled:                     true;
    columns:                     5;
    lines:                       3;
    cycle:                       true;
    dynamic:                     true;
    scrollbar:                   false;
    layout:                      vertical;
    reverse:                     false;
    fixed-height:                false;
    fixed-columns:               false;
    spacing:                     10px;
    margin:                      0px;
    padding:                     0px;
    border:                      0px solid;
    background-color:            transparent;
    text-color:                  @foreground;
    cursor:                      "default";
}
scrollbar {
    handle-width:                5px;
    handle-color:                @accent;
    border-radius:               0px;
    background-color:            @bg2;
}

/*****----- Elements -----*****/
element {
    enabled:                     true;
    spacing:                     8px;
    margin:                      0px;
    padding:                     16px 6px;
    border:                      0px solid;
    border-radius:               12px;
    background-color:            @bg2;
    text-color:                  @foreground;
    orientation:                 vertical;
    cursor:                      pointer;
}
element normal.normal {
    background-color:            @bg2;
    text-color:                  @foreground;
}
element alternate.normal {
    background-color:            @bg2;
    text-color:                  @foreground;
}
element selected.normal {
    background-color:            @accent;
    text-color:                  #2E3440FF;
    border:                      0px;
}
element normal.urgent,
element alternate.urgent {
    background-color:            @bg2;
    text-color:                  @urgent;
}
element selected.urgent {
    background-color:            @urgent;
    text-color:                  #ECEFF4FF;
}
element-icon {
    background-color:            transparent;
    text-color:                  inherit;
    size:                        44px;
    cursor:                      inherit;
}
element-text {
    background-color:            transparent;
    text-color:                  inherit;
    highlight:                   inherit;
    cursor:                      inherit;
    vertical-align:              0.5;
    horizontal-align:            0.5;
    font:                        "DejaVu Sans Mono 10";
}

/*****----- Mode switcher -----*****/
mode-switcher {
    enabled:                     true;
    spacing:                     8px;
    margin:                      0px;
    padding:                     0px;
}
button {
    padding:                     8px 4px;
    border:                      0px 0px 2px 0px solid;
    border-color:                transparent;
    background-color:            transparent;
    text-color:                  @fg-dim;
}
button selected {
    border-color:                @accent2;
    text-color:                  @accent2;
}

/*****----- Message -----*****/
error-message {
    padding:                     15px;
    border:                      1px solid;
    border-radius:               12px;
    border-color:                @urgent;
    background-color:            @bg1;
    text-color:                  @foreground;
}
textbox {
    background-color:            transparent;
    text-color:                  @foreground;
    vertical-align:              0.5;
    horizontal-align:            0.0;
    highlight:                   none;
}
